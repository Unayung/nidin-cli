    info = data.get("trade_info") or find_key(data, "trade_info") or {}
    out = dict(summary)
    out.update({"trade_url": info.get("trade_url"),
                "trade_confirm_url": info.get("trade_confirm_url"),
                "trade_no": info.get("trade_no"),
