def cmd_cart_add(args, client):
    client.need_auth()
    basic = _order_basic(client, args.order_id)
    store_id = basic.get("store_id")
    menu = _full_menu(client, store_id)
    pr, _, combines = _product_tree(menu, args.product_id)

    combine_id = None
    if combines:
        if args.combine:
            c = next((x for x in combines
                      if x["name"] == args.combine or str(x["combine_id"]) == args.combine),
                     None)
            if not c:
                raise Fail(f"no combine {args.combine!r}; have: "
                           + ", ".join(f"{x['name']}={x['combine_id']}" for x in combines),
                           EX_USAGE)
            combine_id = int(c["combine_id"])
        elif len(combines) == 1:
            combine_id = int(combines[0]["combine_id"])
        else:
            raise Fail("this product needs --combine: "
                       + ", ".join(f"{x['name']}={x['combine_id']}" for x in combines),
                       EX_USAGE)

    pr, groups, _ = _product_tree(menu, args.product_id, combine_id)
    item = {"product_id": int(args.product_id), "type": pr.get("type"),
            "amount": args.amount, "options": [],
            "adjusts": _resolve_pick(groups, args.pick)}
    if combine_id is not None:
        item["combine_id"] = combine_id

    price = pr.get("price") or 0
    payload = {"menu_id": basic.get("menu_id"),
               "menu_ver_stamp": basic.get("menu_ver_stamp"),
               "store_id": store_id, "total_money": price * args.amount,
               "products": json.dumps({"items": [item]}, ensure_ascii=False)}

    if args.dry_run:
        return emit(args, {"dry_run": True, "item": item, "payload": payload,
                           "product_name": pr.get("name")},
                    lambda: f"dry run - {args.amount}x {pr.get('name')} "
                            f"({money(price)})\n"
                            + json.dumps(item, ensure_ascii=False, indent=2))

    data = client.call("POST", f"/carts/{args.order_id}/productItem", body=payload)
    return emit(args, {"added": pr.get("name"), "amount": args.amount,
                       "price": price, "response": data},
                f"added {args.amount}x {pr.get('name')} ({money(price)})")


