def _follower_rows(order_info_response):
    """Followers live at the TOP LEVEL of /order/{id}/info as
    group_buy_follower_order_list. There is no GET subOrderCollectStatus
    (that path is PUT-only and GETs return 1001)."""
    raw = order_info_response.get("group_buy_follower_order_list")
    if not isinstance(raw, list):
        return []
    out = []
    for f in raw:
        if not isinstance(f, dict):
            continue
        products = []
        for pr in (f.get("product") or f.get("products")
                   or f.get("product_simple") or []):
            if not isinstance(pr, dict):
                continue
            picks = []
            for a in pr.get("adjusts") or []:
                for o in (a or {}).get("options") or []:
                    if isinstance(o, dict) and o.get("name"):
                        picks.append(o["name"])
            products.append({"name": pr.get("name"),
                             "amount": pr.get("amount"),
                             "money": pr.get("total_money") or pr.get("money"),
                             "options": picks})
        # A follower carries no total of its own - sum the lines.
        subtotal = f.get("total_money") or f.get("money")
        if subtotal is None:
            subtotal = sum(it["money"] or 0 for it in products)
        out.append({"sub_order_id": f.get("order_id") or f.get("sub_order_id"),
                    "name": f.get("contact_name") or f.get("name"),
                    "phone": f.get("contact_method_remark"),
                    "amount": subtotal,
                    "paid": bool(f.get("is_collect_money")),
                    "products": products})
    return out


def _group_snapshot(client, order_id, share_code=None):
    info = client.call("GET", f"/order/{order_id}/info")
    basic = dig(info, "order_info", "basic") or {}
    if not basic:
        raise Fail(f"could not read order {order_id}", EX_ERR, detail=info)
    share_code = share_code or basic.get("share_code")

    brief = {}
    if share_code:
        try:
            brief = (client.call("GET", f"/groupBuy/{share_code}/brief")
                     .get("group_buy_brief") or {})
        except Fail:
            pass

    members = _follower_rows(info)
    own = [{"name": pr.get("name"), "amount": pr.get("amount"),
            "money": pr.get("total_money")}
           for pr in (dig(info, "order_info", "product") or [])
           if isinstance(pr, dict)]

    return {"order_id": order_id,
            "group_buying_name": basic.get("group_buying_name")
                                 or brief.get("group_buying_name"),
            "share_code": share_code,
            "share_link": _share_link(basic.get("store_id"), share_code)
                          if share_code else None,
            "store_name": basic.get("store_name") or brief.get("store_name"),
            "group_buying_status": (brief.get("group_buying_status")
                                    if brief else basic.get("group_buying_status")),
            "total_amount": basic.get("total_money"),
            "item_count": basic.get("total_amount"),
            "sent_sub_count": info.get("sent_sub_count"),
            "owner_items": own,
            "member_count": len(members),
            "paid_count": sum(1 for m in members if m["paid"]),
            "unpaid_total": sum(m["amount"] or 0 for m in members if not m["paid"]),
            "members": members}


def cmd_group_who(args, client):
    """Who ordered what, grouped by person."""
    client.need_auth()
    snap = _group_snapshot(client, args.order_id)

    def human():
        lines = [f"{snap['group_buying_name']} @ {snap['store_name']}  "
                 f"total {money(snap['total_amount'])}"]
        lines.append(f"\n你 (主揪)")
        if snap["owner_items"]:
            for it in snap["owner_items"]:
                lines.append(f"    {it['amount']}x {it['name']}  {money(it['money'])}")
        else:
            lines.append("    (沒點)")
        if not snap["members"]:
            lines.append("\n還沒有人跟團")
            return "\n".join(lines)
        for m in snap["members"]:
            flag = "已付款" if m["paid"] else "還沒付款"
            lines.append(f"\n{m['name']}  {money(m['amount'])}  [{flag}]  "
                         f"(sub_order {m['sub_order_id']})")
            for it in m["products"]:
                opts = ("  " + "/".join(it["options"])) if it["options"] else ""
                lines.append(f"    {it['amount']}x {it['name']}  "
                             f"{money(it['money'])}{opts}")
        return "\n".join(lines)

    return emit(args, snap, human)


