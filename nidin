def cmd_order_set(args, client):
    """updateOrder(): PUT /order/{id}/infoCouponFlow with the fields to change."""
    client.need_auth()
    body = {}
    if args.method:
        code = TRADE_TYPES.get(args.method)
        if code is None:
            raise Fail(f"unknown payment method {args.method!r}; see `nidin pay-methods`",
                       EX_USAGE)
        body["trade_type"] = code
    if args.delivery_type is not None:
        body["delivery_type"] = args.delivery_type
    if args.name:
        body["name"] = args.name
    if args.phone:
        body["phone"] = args.phone
    if args.field:
        for kv in args.field:
            if "=" not in kv:
                raise Fail(f"--field expects k=v, got {kv!r}", EX_USAGE)
            k, v = kv.split("=", 1)
            try:
                body[k] = json.loads(v)
            except ValueError:
                body[k] = v
    if not body:
        raise Fail("nothing to set", EX_USAGE)

    # Switching to 外送 through the generic setter deserves the same check
    # `order delivery` does - otherwise the order silently becomes unpayable.
    if args.delivery_type == 3:
        basic = _order_basic(client, args.order_id)
        store = client.call("GET", f"/store/{basic.get('store_id')}/info")
        store = store.get("store") or store
        blockers = _delivery_blockers(store, total=basic.get("total_money") or 0)
        hard = [b for b in blockers if b["level"] == "hard"]
        if hard:
            raise Fail("無法改成外送:\n" + _delivery_report(hard)
                       + "\n  真的要硬寫: nidin order set <id> --field delivery_type=3",
                       EX_USAGE, detail={"blockers": blockers})
        if blockers:
            warn("外送注意事項:\n" + _delivery_report(blockers))

    if args.dry_run:
        return emit(args, {"dry_run": True,
                           "would_put": {f"/order/{args.order_id}/infoCouponFlow": body}},
                    lambda: json.dumps(body, ensure_ascii=False, indent=2))

    data = client.call("PUT", f"/order/{args.order_id}/infoCouponFlow", body=body)
    return emit(args, {"set": body, "response": data},
                lambda: "set " + ", ".join(f"{k}={v}" for k, v in body.items()))


def cmd_order_pay(args, client):
    """startTrade(): commits the order and returns the payment redirect URL.

    THIS PLACES A REAL ORDER. The shop receives it; trade_url is where the
    customer completes payment (LINE Pay etc.).
    """
    client.need_auth()
    basic = _order_basic(client, args.order_id)
    trade_type = basic.get("trade_type")
    if not trade_type:
        raise Fail("no payment method set - run "
                   f"`nidin order set {args.order_id} --method line_pay` first",
                   EX_USAGE)

    summary = {"order_id": args.order_id, "store": basic.get("store_name"),
               "total": basic.get("total_money"), "items": basic.get("total_amount"),
               "trade_type": trade_type,
               "trade_type_name": TRADE_NAMES.get(trade_type, trade_type)}
    if not args.yes:
        raise Fail("refusing without --yes: this submits a REAL order to "
                   f"{summary['store']} for {money(summary['total'])} "
                   f"({summary['items']} items) via {summary['trade_type_name']}",
                   EX_USAGE, detail=summary)

    body = {"layout": args.layout, "custom_info": {}}
