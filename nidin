                    f"PAY HERE:\n{out['trade_url']}")
        if out["is_trade_finished"]:
            return f"order submitted and already settled (trade_no {out['trade_no']})"
        return json.dumps(out, ensure_ascii=False, indent=2)

    return emit(args, out, human)


