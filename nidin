def main(argv=None):
    args = build_parser().parse_args(argv)
    for key, default in GLOBAL_DEFAULTS.items():
        if not hasattr(args, key):
            setattr(args, key, default)
    try:
        state = load_state()
        client = Client(state, debug=args.debug, timeout=args.timeout)
        rc = args.fn(args, client)
        return rc if isinstance(rc, int) else EX_OK
    except Fail as exc:
        if args.json:
            print(json.dumps({"ok": False, "error": {"message": exc.msg,
                                                     "code": exc.code,
                                                     "detail": exc.detail}},
                             ensure_ascii=False, indent=2))
        else:
            print(f"error: {exc.msg}", file=sys.stderr)
            if exc.detail and args.debug:
                print(json.dumps(exc.detail, ensure_ascii=False, indent=2), file=sys.stderr)
        return exc.code
    except BrokenPipeError:
        return EX_OK


if __name__ == "__main__":
    sys.exit(main())
