# ---------------------------------------------------------------- utilities

class Fail(Exception):
    def __init__(self, msg, code=EX_ERR, detail=None):
        super().__init__(msg)
        self.msg, self.code, self.detail = msg, code, detail


def dig(obj, *path, default=None):
    """Walk nested dicts/lists safely."""
    cur = obj
    for key in path:
        if isinstance(key, int):
            if not isinstance(cur, (list, tuple)) or len(cur) <= key:
                return default
            cur = cur[key]
        else:
            if not isinstance(cur, dict) or key not in cur:
                return default
            cur = cur[key]
    return cur if cur is not None else default


def find_key(obj, name, _depth=0):
    """Breadth-first hunt for a key anywhere in a payload.

    The API is undocumented, so response shapes shift between endpoints. This
    keeps commands working when a field moves one level up or down.
    """
    if _depth > 8:
        return None
    queue = [obj]
    while queue:
        cur = queue.pop(0)
        if isinstance(cur, dict):
            if name in cur and cur[name] is not None:
                return cur[name]
            queue.extend(cur.values())
        elif isinstance(cur, list):
            queue.extend(cur)
    return None


# Mirrors randomString() in the web bundle, typos and all (no 'Y', no 'j').
_DEVICE_ALPHABET = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXTZabcdefghiklmnopqrstuvwxyz"


def rand_suffix():
    n = int(8 * random.random() + 8)
    return "".join(random.choices(_DEVICE_ALPHABET, k=n))


# ------------------------------------------------------------------- state

def load_state():
    env_token = os.environ.get("NIDIN_TOKEN")
    if env_token:
        return {"token": env_token,
                "uid": os.environ.get("NIDIN_UID", "0"),
                "device_id": os.environ.get("NIDIN_DEVICE_ID", ""),
                "source": "env"}
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as fh:
            st = json.load(fh)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as exc:
        raise Fail(f"state file unreadable: {exc}")
    if st.get("token_in_keychain"):
        tok = kc_get(str(st.get("uid", "")))
        if tok:
            st["token"] = tok
    st["source"] = "file"
    return st


def save_state(st):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    out = {k: v for k, v in st.items() if k not in ("source",)}
    if st.get("token_in_keychain"):
        out.pop("token", None)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(out, fh, ensure_ascii=False, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, STATE_FILE)


def kc_set(account, secret):
    subprocess.run(["security", "add-generic-password", "-a", account,
                    "-s", KEYCHAIN_SERVICE, "-w", secret, "-U"],
                   check=True, capture_output=True)


def kc_get(account):
    r = subprocess.run(["security", "find-generic-password", "-a", account,
                        "-s", KEYCHAIN_SERVICE, "-w"],
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def kc_del(account):
    subprocess.run(["security", "delete-generic-password", "-a", account,
                    "-s", KEYCHAIN_SERVICE], capture_output=True)


# ----------------------------------------------------------------- transport

class Client:
    def __init__(self, state=None, debug=False, timeout=20):
        self.state = state if state is not None else {}
        self.debug = debug
        self.timeout = timeout

    def _headers(self, auth):
        h = {"Content-Type": "application/json", "Accept": "application/json",
             "User-Agent": UA, "Origin": WEB, "Referer": WEB + "/"}
        if auth and self.state.get("token"):
            h["MC-API-Token"] = self.state["token"]
            h["MC-API-User"] = str(self.state.get("uid") or 0)
        return h

    def call(self, method, path, query=None, body=None, auth=True, _retried=False):
        url = BASE + path
        if query:
            clean = {k: v for k, v in query.items() if v is not None}
            if clean:
                url += ("&" if "?" in url else "?") + urllib.parse.urlencode(clean)
        payload = json.dumps(body, ensure_ascii=False).encode() if body is not None else None
        req = urllib.request.Request(url, data=payload,
                                     headers=self._headers(auth), method=method)
        if self.debug:
            print(f"[debug] {method} {url}", file=sys.stderr)
            if body is not None:
                print(f"[debug] body {json.dumps(body, ensure_ascii=False)}", file=sys.stderr)

        try:
            with urllib.request.urlopen(req, timeout=self.timeout) as resp:
                raw, http = resp.read(), resp.status
        except urllib.error.HTTPError as exc:
            raw, http = exc.read(), exc.code
        except urllib.error.URLError as exc:
            raise Fail(f"network error: {exc.reason}", EX_NET)
        except TimeoutError:
            raise Fail("request timed out", EX_NET)

        text = raw.decode("utf-8-sig", "replace")
        try:
            data = json.loads(text) if text.strip() else {}
        except ValueError:
            if self.debug:
                print(f"[debug] non-JSON response: {text[:400]}", file=sys.stderr)
            raise Fail(f"non-JSON response (HTTP {http})", EX_ERR,
                       detail={"http": http, "body": text[:2000]})

        if self.debug:
            print(f"[debug] HTTP {http} {json.dumps(data, ensure_ascii=False)[:800]}",
                  file=sys.stderr)

        # The web client refreshes on this flag rather than on an expiry clock.
        if data.get("token_need_replace") and not _retried and self.state.get("uid"):
            if self.refresh_token():
                return self.call(method, path, query, body, auth, _retried=True)

        status = data.get("status", http)
        if http in (401, 403) or status in (401, 403):
            raise Fail("not authenticated - run `nidin login`", EX_AUTH,
                       detail={"http": http, "status": status, "body": data})
        if http >= 400 or (isinstance(status, int) and status >= 400):
            # The API explains itself in `message`/`description` - surface it.
            note = data.get("message") or data.get("description") or ""
            label = f"{note} " if note else ""
            raise Fail(f"{label}(http {http}, status {status})", EX_ERR,
                       detail={"http": http, "status": status, "body": data})
        return data

    def refresh_token(self):
        uid = self.state.get("uid")
        if not uid:
            return False
        try:
            data = self.call("GET", f"/user/{uid}/replaceToken", auth=True, _retried=True)
        except Fail:
            return False
        tok = data.get("token") or find_key(data, "token")
        if not tok:
            return False
        self.state["token"] = tok
        if self.state.get("source") != "env":
            if self.state.get("token_in_keychain"):
                kc_set(str(uid), tok)
            save_state(self.state)
        return True

    def need_auth(self):
        if not self.state.get("token"):
            raise Fail("not logged in - run `nidin login --phone <number>`", EX_AUTH)


# ------------------------------------------------------------------- output

def emit(args, data, human=None):
    if args.json:
        print(json.dumps({"ok": True, "data": data}, ensure_ascii=False, indent=2))
    elif human is not None:
        print(human() if callable(human) else human)
    else:
        print(json.dumps(data, ensure_ascii=False, indent=2))


def warn(msg):
    """A user-facing warning. stderr, so --json output stays parseable."""
    print(msg, file=sys.stderr)


def _w(text):
    """Display width, counting CJK glyphs as two columns."""
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in str(text))


def _pad(text, width):
    return str(text) + " " * max(0, width - _w(text))


def table(rows, headers):
    if not rows:
        return "(no rows)"
    cols = list(zip(*([headers] + rows)))
    widths = [max(_w(c) for c in col) for col in cols]
    out = ["  ".join(_pad(h, w) for h, w in zip(headers, widths)).rstrip(),
           "  ".join("-" * w for w in widths)]
    for r in rows:
        out.append("  ".join(_pad(c, w) for c, w in zip(r, widths)).rstrip())
    return "\n".join(out)


def money(v):
    try:
        return f"${int(v):,}"
    except (TypeError, ValueError):
        return str(v if v is not None else "-")


