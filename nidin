def cmd_order_delivery(args, client):
    """Switch an order to 外送 and attach an address.

    Field names are `address_*`, NOT `delivery_address_*` - the latter are
    silently ignored by infoCouponFlow.
    """
    client.need_auth()
    basic = _order_basic(client, args.order_id)
    store = client.call("GET", f"/store/{basic.get('store_id')}/info")
    store = store.get("store") or store

    if args.index is not None:
        saved = client.call("GET", "/user/listOrderedAddress")
        rows = saved.get("list") or find_key(saved, "list") or []
        if args.index >= len(rows):
            raise Fail(f"no saved address #{args.index} (have {len(rows)})", EX_USAGE)
        a = rows[args.index]
        address = a.get("address")
        short = a.get("address_short")
        city, area = a.get("city_code"), a.get("area_code")
        lat, lng = float(a.get("latitude")), float(a.get("longitude"))
        note = args.note if args.note is not None else a.get("loc_name") or ""
    else:
        missing = [n for n, v in (("--address", args.address), ("--lat", args.lat),
                                  ("--lng", args.lng), ("--city-code", args.city_code),
                                  ("--area-code", args.area_code)) if v is None]
        if missing:
            raise Fail("need " + ", ".join(missing)
                       + "  (or --index N from `nidin addresses`)", EX_USAGE)
        address = short = args.address
        city, area = args.city_code, args.area_code
        lat, lng = args.lat, args.lng
        note = args.note or ""

    distance = args.distance
    approx = False
    if distance is None:
        try:
            distance = int(_haversine_m(float(store.get("latitude")),
                                        float(store.get("longitude")), lat, lng))
            approx = True
        except (TypeError, ValueError):
            raise Fail("could not estimate distance; pass --distance <metres>", EX_ERR)

    # Delivery minimums are tiered by distance in the store's delivery_info.
    total = basic.get("total_money") or 0
    blockers = _delivery_blockers(store, distance=distance, total=total)
    hard = [b for b in blockers if b["level"] == "hard"]
    if hard:
        # No --distance escape for out_of_range: the estimate is straight-line,
        # so the real routed distance can only be worse.
        raise Fail("無法設定外送:\n" + _delivery_report(hard)
                   + f"\n  改自取: nidin order set {args.order_id} --delivery-type 1",
                   EX_USAGE, detail={"blockers": blockers})
    tiers = _delivery_tiers(store)
    min_price = _min_spend(tiers, distance)

    body = {"delivery_type": 3, "address": address, "address_short": short,
            "address_formatted": address,
            "address_city_code": city, "address_area_code": area,
            "delivery_latitude": lat, "delivery_longitude": lng,
            "delivery_location": note,
            "delivery_distance": distance, "delivery_duration": args.duration,
            "distance_service_model": store.get("distance_service_model") or 0,
            "distance_service_vendor": store.get("distance_service_vendor") or 0,
            "distance_service_vendor_info": "{}"}

    result = {"order_id": args.order_id, "store": store.get("name"),
              "address": short, "note": note,
              "distance_m": distance, "distance_is_estimate": approx,
              "min_spend": min_price, "order_total": total,
              "meets_minimum": total >= min_price,
              "short_by": max(0, min_price - total),
              "delivery_blockers": blockers}

    if args.dry_run:
        return emit(args, {"dry_run": True, "would_put": body, **result},
                    lambda: json.dumps(result, ensure_ascii=False, indent=2))

    client.call("PUT", f"/order/{args.order_id}/infoCouponFlow", body=body)

    after = _order_basic(client, args.order_id)
    if after.get("delivery_type") != 3 or not after.get("delivery_address"):
        raise Fail("write did not take - the order did not record the address",
                   EX_ERR, detail={"sent": body,
                                   "now": {k: after.get(k) for k in
                                           ("delivery_type", "delivery_address")}})
    result["delivery_distance_recorded"] = after.get("delivery_distance")

    def human():
        lines = [f"外送 set for order {args.order_id}",
                 f"  to       : {short}" + (f"  ({note})" if note else ""),
                 f"  distance : {distance} m"
                 + ("  (straight-line estimate)" if approx else ""),
                 f"  min spend: {money(min_price)}   order: {money(total)}"]
        if not result["meets_minimum"]:
            lines.append(f"  SHORT BY {money(result['short_by'])} - checkout will "
                         f"reject until the group reaches {money(min_price)}")
        others = [b for b in blockers if b["code"] != "below_minimum"]
        if others:
            lines.append(_delivery_report(others))
        return "\n".join(lines)

    return emit(args, result, human)


def _slot_config(store, delivery_type):
    """(lead minutes, slot width minutes) for a delivery type."""
    for d in store.get("delivery_time_info") or []:
        if d.get("delivery_type") == delivery_type:
            return (d.get("available_time") or 0), (d.get("duration") or 30)
    return 0, 30


def _day_window(store, day):
    """(order_start, order_end) as HH:MM:SS for a date, from the weekly table."""
    # week_day 1 = Monday, matching Python's isoweekday().
    for row in store.get("opening_times_weekly") or []:
        if row.get("week_day") == day.isoweekday():
            return (row.get("order_start_time") or store.get("order_start_time"),
                    row.get("order_end_time") or store.get("order_end_time"))
    return store.get("order_start_time"), store.get("order_end_time")


def _slots(store, day, delivery_type, now=None):
    lead, width = _slot_config(store, delivery_type)
    start_s, end_s = _day_window(store, day)
    if not start_s or not end_s:
        return [], width
    to_t = lambda v: _dt.datetime.strptime(v[:8], "%H:%M:%S").time()
    begin = _dt.datetime.combine(day, to_t(start_s))
    end = _dt.datetime.combine(day, to_t(end_s))
    if now and day == now.date():
        earliest = now + _dt.timedelta(minutes=lead)
        # round up to the next slot boundary
        begin = max(begin, earliest.replace(second=0, microsecond=0))
        rem = begin.minute % width
        if rem:
            begin += _dt.timedelta(minutes=width - rem)
    out = []
    cur = begin
    while cur + _dt.timedelta(minutes=width) <= end:
        out.append(cur)
        cur += _dt.timedelta(minutes=width)
    return out, width


def cmd_order_time(args, client):
    """List or set the reserved pickup/delivery slot on an order."""
    client.need_auth()
    basic = _order_basic(client, args.order_id)
    store = client.call("GET", f"/store/{basic.get('store_id')}/info")
    store = store.get("store") or store
    dtype = basic.get("delivery_type") or 1
    now = _dt.datetime.now()
    # Structural feasibility only - the spend shortfall belongs to
    # `order delivery` / `group status`, not to picking a time slot.
    blockers = _delivery_blockers(store) if dtype == 3 else []
    if blockers:
        warn("這張單是外送，但:\n" + _delivery_report(blockers))

    if args.date:
        try:
            day = _dt.datetime.strptime(args.date, "%Y-%m-%d").date()
        except ValueError:
            raise Fail("--date must be YYYY-MM-DD", EX_USAGE)
    else:
        day = now.date()

    horizon = store.get("order_tolerance_day")
    if horizon is not None and (day - now.date()).days > horizon:
        raise Fail(f"{store.get('name')} only books {horizon} days ahead", EX_USAGE)
    if store.get("is_off_day") and day == now.date():
        raise Fail("store is closed today", EX_USAGE)

    slots, width = _slots(store, day, dtype, now)

    if not args.time and not args.asap:
        out = {"order_id": args.order_id, "store": store.get("name"),
               "delivery_type": dtype,
               "delivery_type_name": DELIVERY_NAMES.get(dtype, dtype),
               "delivery_blockers": blockers,
               "date": day.isoformat(), "slot_minutes": width,
               "book_days_ahead": horizon,
               "current": {"date": basic.get("delivery_reserv_date"),
                           "time": basic.get("delivery_reserv_time"),
                           "tolerance": basic.get("delivery_reserv_tolerance"),
                           "is_asap": basic.get("is_asap"),
                           "order_method": basic.get("order_method")},
               "slots": [t.strftime("%H:%M") for t in slots]}

        def human():
            cur = out["current"]
            head = (f"{store.get('name')}  {out['delivery_type_name']}  "
                    f"slot={width}min  books {horizon}d ahead\n"
                    f"current: {cur['date']} {cur['time']} "
                    f"(±{cur['tolerance']}min"
                    + (", ASAP" if cur["is_asap"] else "") + ")\n\n"
                    f"{day.isoformat()} available:")
            if blockers:
                head = _delivery_report(blockers) + "\n" + head
            if not out["slots"]:
                return head + "\n  (none left today - try --date tomorrow)"
            rows, line = [], []
            for t in out["slots"]:
                line.append(t)
                if len(line) == 8:
                    rows.append("  " + "  ".join(line)); line = []
            if line:
                rows.append("  " + "  ".join(line))
            return head + "\n" + "\n".join(rows)

        return emit(args, out, human)

    want = None
    if args.asap:
        body = {"is_asap": 1}
    else:
        valid = {t.strftime("%H:%M") for t in slots}
        want = args.time[:5]
        if want not in valid:
            raise Fail(f"{want} is not a valid slot on {day}; "
                       + (f"available: {', '.join(sorted(valid))}" if valid
                          else "no slots left that day"), EX_USAGE)
        # The wire field is delivery_reserv_start_time - a single "date time"
        # string. delivery_reserv_date/_time are read-only echoes; sending them
        # returns 200 and changes nothing.
        body = {"is_asap": 0,
                "delivery_reserv_start_time": f"{day.isoformat()} {want}:00"}

    if args.dry_run:
        return emit(args, {"dry_run": True, "would_put": body},
                    lambda: json.dumps(body, ensure_ascii=False, indent=2))

    client.call("PUT", f"/order/{args.order_id}/infoCouponFlow", body=body)

    after = _order_basic(client, args.order_id)
    got_date, got_time = (after.get("delivery_reserv_date"),
                          (after.get("delivery_reserv_time") or "")[:5])
    if want and (got_date != day.isoformat() or got_time != want):
        raise Fail(f"write did not take - order still says {got_date} {got_time}",
                   EX_ERR, detail={"sent": body, "now": {"date": got_date,
                                                         "time": got_time}})

    limit = {}
    if want:
        try:
            limit = client.call(
                "POST", f"/carts/{args.order_id}/checkAmountLimit",
                body={"delivery_reserv_start_time": f"{day} {want}:00",
                      "delivery_type": dtype})
        except Fail:
            pass
    out = {"set": body, "date": got_date, "time": got_time,
           "tolerance": after.get("delivery_reserv_tolerance"),
           "order_method": after.get("order_method"),
           "is_asap": after.get("is_asap"),
           "over_limit": bool(limit.get("is_over_limit")),
           "limit_list": limit.get("limit_list") or []}
    return emit(args, out,
                lambda: ("ASAP set" if args.asap else
                         f"slot set: {got_date} {got_time} "
                         f"(±{out['tolerance']}min, order_method={out['order_method']})")
                        + ("  [OVER STORE LIMIT]" if out["over_limit"] else ""))


