    return emit(args, data)


def decode_schema_map(blob):
    """Same as decode_schema_list but keyed by the data dict's own id key."""
    if not isinstance(blob, dict):
        return {}
    schema, data = blob.get("schema"), blob.get("data")
    if not isinstance(schema, dict) or not isinstance(data, dict):
        return {}
    inv = {idx: name for name, idx in schema.items() if isinstance(idx, int)}
    out = {}
    for key, row in data.items():
        if isinstance(row, list):
            out[str(key)] = {inv[i]: v for i, v in enumerate(row) if i in inv}
        elif isinstance(row, dict):
            out[str(key)] = row
    return out


def decode_schema_list(blob):
    """Decode the menu's schema+positional-array encoding.

    Menus ship as {"schema": {field: index}, "data": {id: [v0, v1, ...]}} to keep
    the payload small. Expand each row back into a dict.
    """
    if not isinstance(blob, dict):
        return []
    schema, data = blob.get("schema"), blob.get("data")
    if not isinstance(schema, dict) or not isinstance(data, dict):
        return []
    inv = {idx: name for name, idx in schema.items() if isinstance(idx, int)}
    out = []
    for row in data.values():
        if not isinstance(row, list):
            continue
        out.append({inv[i]: v for i, v in enumerate(row) if i in inv})
    return out


def cmd_menu(args, client):
    if args.version:
        return emit(args, client.call("GET", f"/store/{args.store_id}/onShelfMenuVer"))
    data = client.call("GET", f"/store/{args.store_id}/onShelfMenu")
    menu = data.get("menu") or {}
    if args.full:
        return emit(args, menu)

    products = decode_schema_list(menu.get("product_list_json"))
    # type 1 is a sellable product; the rest are options/addons/combos.
    rows = [{"product_id": pr.get("product_id"), "name": pr.get("name"),
             "price": pr.get("price"), "type": pr.get("type"),
             "visible": pr.get("is_visible"), "enabled": pr.get("is_enable")}
            for pr in products]
    if not args.all:
        rows = [r for r in rows if r["type"] == 1 and r["visible"] and r["enabled"]]
    if args.keyword:
        kw = args.keyword.lower()
        rows = [r for r in rows if kw in str(r["name"] or "").lower()]
    rows.sort(key=lambda r: (r["name"] or ""))

    def human():
        shown = rows[:args.limit]
        body = table([[r["product_id"], r["name"], money(r["price"])] for r in shown],
                     ["product_id", "name", "price"])
        if len(rows) > len(shown):
            body += f"\n... {len(rows)} products total (--limit to show more)"
        return body

    return emit(args, rows, human)


