def _full_menu(client, store_id):
    menu = client.call("GET", f"/store/{store_id}/onShelfMenu").get("menu") or {}
    return {"products": decode_schema_map(menu.get("product_list_json")),
            "adjusts": decode_schema_map(menu.get("adjust_list_json")),
            "options": decode_schema_map(menu.get("option_list_json")),
            "combines": decode_schema_map(menu.get("combine_list_json"))}


# edge_list row = [id, qty, null, price_type, kind]; kind 1=product, 2=option,
# 20=whole adjust group allowed.
EDGE_OPTION, EDGE_GROUP = 2, 20


def _combine_allow(menu, combine_id):
    """(allowed option ids, adjust groups opened wholesale) for one combine."""
    edges = (menu["combines"].get(str(combine_id)) or {}).get("edge_list") or {}
    options, groups = set(), set()
    for key, row in edges.items():
        kind = row[4] if isinstance(row, list) and len(row) > 4 else None
        if kind == EDGE_OPTION:
            options.add(str(key))
        elif kind == EDGE_GROUP:
            groups.add(str(key))
    return options, groups


def _product_tree(menu, product_id, combine_id=None):
    pr = menu["products"].get(str(product_id))
    if pr is None:
        raise Fail(f"product {product_id} not on this menu", EX_USAGE)

    combines = [{"combine_id": cid,
                 "name": (menu["combines"].get(str(cid)) or {}).get("name")}
                for cid in (pr.get("combine_list") or [])]

    allow_opt, allow_grp = (_combine_allow(menu, combine_id)
                            if combine_id is not None else (None, None))

    groups = []
    for aid in pr.get("adjust_list") or []:
        a = menu["adjusts"].get(str(aid))
        if not a:
            continue
        oids = [str(o) for o in (a.get("option_list") or [])]
        # A combine either opens the whole group or whitelists single options.
        if allow_opt is not None and str(aid) not in allow_grp:
            oids = [o for o in oids if o in allow_opt]
            if not oids:
                continue
        groups.append({
            "adjust_id": aid, "name": a.get("name"),
            "mandatory": bool(a.get("is_mandatory")),
            "min": a.get("min_limit"), "max": a.get("max_limit"),
            "options": [{"option_id": int(o),
                         "name": (menu["options"].get(o) or {}).get("name"),
                         "price": (menu["options"].get(o) or {}).get("price")}
                        for o in oids],
        })
    return pr, groups, combines


def cmd_product(args, client):
    menu = _full_menu(client, args.store_id)
    pr, _, combines = _product_tree(menu, args.product_id)
    combine_id = None
    if args.combine:
        c = next((x for x in combines if x["name"] == args.combine
                  or str(x["combine_id"]) == args.combine), None)
        if not c:
            raise Fail(f"no combine {args.combine!r}", EX_USAGE)
        combine_id = c["combine_id"]
    elif len(combines) == 1:
        combine_id = combines[0]["combine_id"]
    pr, groups, combines = _product_tree(menu, args.product_id, combine_id)
    out = {"product_id": pr.get("product_id"), "name": pr.get("name"),
           "price": pr.get("price"), "combines": combines, "groups": groups}

    def human():
        lines = [f"{pr.get('name')}  {money(pr.get('price'))}  "
                 f"(product_id {pr.get('product_id')})"]
        if combines:
            lines.append("\ncombine (--combine): "
                         + ", ".join(f"{c['name']}={c['combine_id']}" for c in combines))
        for g in groups:
            tag = "REQUIRED" if g["mandatory"] else "optional"
            lines.append(f"\n[{tag}] {g['name']}  (max {g['max']})")
            for o in g["options"]:
                extra = f" +{money(o['price'])}" if o.get("price") else ""
                lines.append(f"    {o['option_id']}  {o['name']}{extra}")
        return "\n".join(lines)

    return emit(args, out, human)


def _resolve_pick(groups, picks):
    """Turn --pick 甜度=半糖 into the adjusts payload."""
    chosen, by_name = [], {g["name"]: g for g in groups}
    for raw in picks or []:
        if "=" not in raw:
            raise Fail(f"--pick expects group=option, got {raw!r}", EX_USAGE)
        gname, oname = (x.strip() for x in raw.split("=", 1))
        g = by_name.get(gname) or next(
            (x for x in groups if str(x["adjust_id"]) == gname), None)
        if not g:
            raise Fail(f"no option group named {gname!r}; have: "
                       + ", ".join(by_name), EX_USAGE)
        opt = next((o for o in g["options"]
                    if o["name"] == oname or str(o["option_id"]) == oname), None)
        if not opt:
            raise Fail(f"{gname!r} has no choice {oname!r}; have: "
                       + ", ".join(str(o["name"]) for o in g["options"]), EX_USAGE)
        chosen.append({"adjust_id": int(g["adjust_id"]),
                       "options": [{"option_id": int(opt["option_id"]), "amount": 1}]})
    picked_ids = {a["adjust_id"] for a in chosen}
    missing = [g["name"] for g in groups
               if g["mandatory"] and int(g["adjust_id"]) not in picked_ids]
    if missing:
        raise Fail("missing required choices: " + ", ".join(missing)
                   + "  (use --pick '<group>=<option>'; see `nidin product`)",
                   EX_USAGE)
    return chosen


def cmd_group_create(args, client):
    """開團: build an empty group cart for a store, then open the group buy.

    Mirrors the web's newGbOrder() -> toGroupBuy() pair. No products needed:
    `is_empty: 1` is exactly how the site creates a 主揪 cart.
    """
    client.need_auth()
    store = client.call("GET", f"/store/{args.store_id}/info")
    brand_id = find_key(store, "brand_id")
    store_name = find_key(store, "name")
    ver = client.call("GET", f"/store/{args.store_id}/onShelfMenuVer")
    menu_id = ver.get("menu_id") or find_key(ver, "menu_id")
    stamp = dig(ver, "version", "stamp") or find_key(ver, "stamp")

    if not all([brand_id, menu_id, stamp]):
        raise Fail("could not resolve brand_id/menu_id/menu_ver_stamp", EX_ERR,
                   detail={"brand_id": brand_id, "menu_id": menu_id, "stamp": stamp})

    # Default to 外送. A store that cannot deliver falls back to 自取; an explicit
    # --delivery-type is honoured as given, but never silently - see below.
    info = store.get("store") or store
    dtype = DEFAULT_DELIVERY_TYPE if args.delivery_type is None else args.delivery_type
    blockers = _delivery_blockers(info) if dtype == 3 else []
    hard = [b for b in blockers if b["level"] == "hard"]
    fell_back = args.delivery_type is None and any(b["code"] == "not_offered"
                                                   for b in hard)
    if fell_back:
        dtype = 1
    if blockers:
        head = ("外送不可用，已改開自取:" if fell_back
                else f"外送可能開不成 ({store_name}):")
        warn(head + "\n" + _delivery_report(blockers)
             + ("\n  改自取: nidin group create <store_id> --delivery-type 1"
                if hard and not fell_back else ""))

    plan = {"store_id": int(args.store_id), "store_name": store_name,
            "brand_id": brand_id, "menu_id": menu_id, "menu_ver_stamp": stamp,
            "order_type": 2, "is_empty": 1, "delivery_type": dtype}

    if args.dry_run:
        return emit(args, {"dry_run": True, "would_post": {"/carts/item": plan},
                           "delivery_fallback": fell_back,
                           "delivery_blockers": blockers},
                    lambda: "dry run - would POST /carts/item with:\n"
                            + json.dumps(plan, ensure_ascii=False, indent=2))

    cart = client.call("POST", "/carts/item", body=plan)
    order_id = cart.get("order_id") or find_key(cart, "order_id")
    if not order_id:
        raise Fail("cart created but no order_id returned", EX_ERR, detail=cart)

    # An order_type:2 cart is already a group buy - /carts/item hands back the
    # code as `sharing_code`. toGroupBuy is only for converting a solo cart and
    # returns 41001 here.
    share_code = cart.get("sharing_code") or find_key(cart, "sharing_code")
    if not share_code:
        gb = client.call("POST", f"/carts/{order_id}/toGroupBuy", body=None)
        share_code = (dig(gb, "group_buy_info", "group_buy_list", 0, "share_code")
                      or find_key(gb, "sharing_code") or find_key(gb, "share_code"))
    if not share_code:
        raise Fail(f"cart {order_id} created but no share code returned",
                   EX_ERR, detail=cart)

    link = _share_link(args.store_id, share_code)
    out = {"order_id": order_id, "order_sn": cart.get("order_sn"),
           "store_id": int(args.store_id), "store_name": store_name,
           "delivery_type": dtype,
           "delivery_type_name": DELIVERY_NAMES.get(dtype, dtype),
           "delivery_fallback": fell_back,
           "delivery_blockers": blockers,
           "share_code": share_code, "share_link": link}

    def text():
        head = f"開團成功 - {store_name}  {out['delivery_type_name']}"
        if fell_back:
            head += "  (此店不提供外送，已改為自取)"
        body = [f"{head}\norder_id: {order_id}"]
        if blockers:
            body.append(_delivery_report(blockers))
        if dtype == 3:
            body.append(f"外送還需要地址: nidin order delivery {order_id} --index 0")
        return "\n".join(body) + f"\n\n{link}"

    return emit(args, out, text)


