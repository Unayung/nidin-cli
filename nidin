DELIVERY_TYPES = {"pickup": 1, "dine_in": 2, "delivery": 3, "take_out": 4,
                  "store_delivery": 21}
DELIVERY_NAMES = {1: "自取", 2: "內用", 3: "外送", 4: "外帶", 21: "店家外送/取號"}
# What `group create` uses when the caller does not say. Stores that do not
# deliver fall back to 自取 - see cmd_group_create.
DEFAULT_DELIVERY_TYPE = 3


def _delivery_tiers(store):
    """外送 minimum-spend tiers as (min_distance_m, min_price), nearest first.

    Empty means the store does not deliver at all.
    """
    return sorted(((d.get("order_min_distance_m") or 0, d.get("order_min_price") or 0)
                   for d in (store.get("delivery_info") or [])
                   if d.get("delivery_type") == 3), key=lambda t: t[0])


def _min_spend(tiers, distance):
    """The 外送 minimum that applies at `distance` metres."""
    applicable = [t for t in tiers if distance >= t[0]] or [tiers[0]]
    return applicable[-1][1]


def _delivery_blockers(store, distance=None, total=None):
    """Everything standing between this store and a 外送 order, as a list.

    Each entry is {code, level, message}. `level` "hard" means the order cannot
    go out as 外送 at all; "warn" means it can be written but the user has to
    know (a spend shortfall, an exception calendar). Empty list = nothing found.
    Checks that need a value you did not pass (distance, total) are skipped.
    """
    out = []
    tiers = _delivery_tiers(store)
    name = store.get("name") or "此店"

    if not tiers:
        out.append({"code": "not_offered", "level": "hard",
                    "message": f"{name} 不提供外送 (delivery_info 沒有 delivery_type 3)"})
    else:
        if not any(d.get("delivery_type") == 3 and d.get("available_time") is not None
                   for d in store.get("delivery_time_info") or []):
            out.append({"code": "no_slot_config", "level": "warn",
                        "message": f"{name} 沒有設定外送時段 "
                                   f"(delivery_time_info 的 delivery_type 3 是 null)"})

    if store.get("is_close"):
        out.append({"code": "store_closed", "level": "hard",
                    "message": f"{name} 目前暫停接單 (is_close=1)"})
    if store.get("is_off_day"):
        out.append({"code": "off_day", "level": "hard",
                    "message": f"{name} 今日公休"})

    cap = store.get("max_delivery_distance_m")
    if tiers and distance is not None and cap and distance > cap:
        out.append({"code": "out_of_range", "level": "hard",
                    "message": f"地址距離 {distance} m，超過 {name} 的外送上限 {cap} m"})

    if tiers and total is not None:
        floor = _min_spend(tiers, distance if distance is not None else 0)
        if total < floor:
            out.append({"code": "below_minimum", "level": "warn",
                        "message": f"目前 {money(total)} 未達外送門檻 {money(floor)}"
                                   f"，還差 {money(floor - total)}"})

    # The exception calendar is per delivery_type; every store seen so far has
    # empty lists, so the encoding of week_day/month_day is unverified - report
    # it literally instead of guessing which days it blocks.
    cal = (store.get("delivery_exception_calendar") or {}).get("3") or {}
    marked = {k: v for k, v in cal.items() if v}
    if marked:
        out.append({"code": "exception_calendar", "level": "warn",
                    "message": f"{name} 設有外送例外日，請自行確認: "
                               + json.dumps(marked, ensure_ascii=False)})
    return out


def _delivery_report(blockers):
    """Multi-line, unmissable rendering of _delivery_blockers()."""
    if not blockers:
        return ""
    lines = []
    for b in blockers:
        tag = "無法外送" if b["level"] == "hard" else "注意"
        lines.append(f"  [{tag}] {b['message']}")
    return "\n".join(lines)


def _haversine_m(lat1, lng1, lat2, lng2):
    r = 6371000.0
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dp, dl = math.radians(lat2 - lat1), math.radians(lng2 - lng1)
    a = math.sin(dp / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2
    return 2 * r * math.asin(math.sqrt(a))


