def cmd_raw(args, client):
    body = None
    if args.data:
        src = sys.stdin.read() if args.data == "-" else args.data
        try:
            body = json.loads(src)
        except ValueError as exc:
            raise Fail(f"--data is not valid JSON: {exc}", EX_USAGE)
    query = {}
    for item in args.query or []:
        if "=" not in item:
            raise Fail(f"--query expects k=v, got {item!r}", EX_USAGE)
        k, v = item.split("=", 1)
        query[k] = v
    path = args.path if args.path.startswith("/") else "/" + args.path
    data = client.call(args.method.upper(), path, query=query or None,
                       body=body, auth=not args.no_auth)
    return emit(args, data)


# -------------------------------------------------------------------- parser

GLOBAL_DEFAULTS = {"json": False, "debug": False, "raw_body": False, "timeout": 20}


def _common_parser():
    c = argparse.ArgumentParser(add_help=False)
    c.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                   help="machine-readable JSON output")
    c.add_argument("--debug", action="store_true", default=argparse.SUPPRESS,
                   help="dump requests/responses to stderr")
    c.add_argument("--raw-body", action="store_true", default=argparse.SUPPRESS,
                   help="include the raw API payload")
    c.add_argument("--timeout", type=int, default=argparse.SUPPRESS)
    return c


