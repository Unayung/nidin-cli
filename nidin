def cmd_login(args, client):
    phone = args.phone or os.environ.get("NIDIN_PHONE")
    if not phone:
        raise Fail("--phone required (or set NIDIN_PHONE)", EX_USAGE)

    password = args.password or os.environ.get("NIDIN_PASSWORD")
    if args.password_stdin:
        password = sys.stdin.readline().rstrip("\n")
    if not password:
        if not sys.stdin.isatty():
            raise Fail("no password: use --password-stdin or NIDIN_PASSWORD", EX_USAGE)
        import getpass
        password = getpass.getpass("你訂 password: ")

    device_id = client.state.get("device_id") or f"NIDINShopperWeb_{rand_suffix()}"
    body = {"type": args.type, "account": phone, "password": password,
            "device_id": device_id, "identity": args.identity}
    data = client.call("POST", "/user/loginWeb", body=body, auth=False)

    token = find_key(data, "token")
    uid = find_key(data, "user_id")
    if not token:
        raise Fail("login returned no token", EX_AUTH, detail=data)

    st = {"token": token, "uid": uid, "phone": phone, "device_id": device_id,
          "token_in_keychain": bool(args.keychain), "logged_in_at": int(time.time())}
    if args.keychain:
        kc_set(str(uid), token)
    save_state(st)
    client.state = st

    warn = []
    if data.get("phone_need_verify") or data.get("account_need_verify"):
        warn.append("account still needs phone verification in the app")
    if data.get("is_phone_mismatch"):
        warn.append("login phone does not match the profile phone")
    if not data.get("is_profile_completed", True):
        warn.append("profile incomplete")

    out = {"uid": uid, "phone": phone, "stored": STATE_FILE,
           "keychain": bool(args.keychain),
           "is_guest": bool(find_key(data, "is_guest")),
           "warnings": warn}
    return emit(args, out,
                lambda: f"logged in as uid={uid} ({phone})\ntoken stored in "
                        f"{'Keychain' if args.keychain else STATE_FILE}"
                        + ("".join(f"\nwarning: {w}" for w in warn)))


def cmd_logout(args, client):
    st = client.state
    try:
        client.call("GET", "/logoutWeb")
    except Fail:
        pass
    if st.get("token_in_keychain"):
        kc_del(str(st.get("uid", "")))
    if os.path.exists(STATE_FILE):
        os.remove(STATE_FILE)
    return emit(args, {"logged_out": True}, "logged out; local token removed")


def cmd_whoami(args, client):
    client.need_auth()
    data = client.call("GET", f"/user/{client.state.get('uid')}/info")
    info = {
        "uid": data.get("user_id") or client.state.get("uid"),
        "phone": data.get("phone") or client.state.get("phone"),
        "name": data.get("name") or data.get("nickname") or None,
        "email": data.get("email") or None,
        "account_type": data.get("account_type"),
        "is_guest": bool(data.get("is_guest")),
        "profile_completed": bool(data.get("is_profile_completed")),
        "phone_verified": not bool(data.get("phone_need_verify")),
        "token_source": client.state.get("source"),
    }
    if args.raw_body:
        info["raw"] = data

    def human():
        lines = [f"uid     : {info['uid']}",
                 f"phone   : {info['phone']} "
                 f"({'verified' if info['phone_verified'] else 'UNVERIFIED'})",
                 f"name    : {info['name'] or '(not set)'}",
                 f"type    : {info['account_type']}"
                 f"{' (guest)' if info['is_guest'] else ''}",
                 f"profile : {'complete' if info['profile_completed'] else 'incomplete'}",
                 f"token   : {info['token_source']}"]
        return "\n".join(lines)

    return emit(args, info, human)


def cmd_doctor(args, client):
    checks = []
    try:
        client.call("GET", "/store/listByDefault", query={"page": 1, "count": 1}, auth=False)
        checks.append(("api reachable", True, BASE))
    except Fail as exc:
        checks.append(("api reachable", False, exc.msg))
    tok = client.state.get("token")
    checks.append(("token present", bool(tok), client.state.get("source", "none")))
    if tok:
        try:
            client.call("GET", f"/user/{client.state.get('uid')}/info")
            checks.append(("token valid", True, f"uid={client.state.get('uid')}"))
        except Fail as exc:
            checks.append(("token valid", False, exc.msg))
    ok = all(c[1] for c in checks)
    emit(args, {"ok": ok, "checks": [{"name": n, "pass": p, "detail": d}
                                     for n, p, d in checks]},
         lambda: table([[n, "PASS" if p else "FAIL", d] for n, p, d in checks],
                       ["check", "result", "detail"]))
    if ok:
        return EX_OK
    return EX_NET if not checks[0][1] else EX_AUTH


def cmd_stores(args, client):
    if args.lat is not None and args.lng is not None:
        path, query = "/store/listByPositionNew", {
            "latitude": args.lat, "longitude": args.lng, "page": args.page,
            "count": args.count, "address": args.address or "",
            "brand_code": args.brand or "", "distance_km": args.distance_km,
            "src_type": 3 if args.address else None}
    else:
        path, query = "/store/listByDefault", {"page": args.page, "count": args.count}

    data = client.call("GET", path, query=query)
    items = data.get("list") or find_key(data, "list") or []
    if args.keyword:
        kw = args.keyword.lower()
        items = [s for s in items
                 if kw in json.dumps(s, ensure_ascii=False).lower()]

    rows = [{"id": dig(s, "id") or dig(s, "store_id"),
             "name": dig(s, "name") or dig(s, "store_name"),
             "brand": dig(s, "brand_name") or dig(s, "brand_code"),
             "distance_m": dig(s, "distance"),
             "address": dig(s, "address"),
             "is_close": dig(s, "is_close")} for s in items]
    return emit(args, rows,
                lambda: table([[r["id"], r["name"],
                                f"{r['distance_m']:.0f}" if isinstance(r["distance_m"], (int, float)) else "-",
                                "closed" if r["is_close"] else "open",
                                (r["address"] or "")[:34]] for r in rows],
                              ["id", "name", "metres", "status", "address"]))


def cmd_store(args, client):
