def cmd_group_watch(args, client):
    client.need_auth()
    prev = None
    try:
        while True:
            snap = _group_snapshot(client, args.order_id)
            sig = json.dumps(snap, sort_keys=True, ensure_ascii=False)
            changed = sig != prev
            if changed or args.every_tick:
                stamp = time.strftime("%H:%M:%S")
                if args.json:
                    print(json.dumps({"ok": True, "at": stamp, "changed": changed,
                                      "data": snap}, ensure_ascii=False), flush=True)
                else:
                    print(f"[{stamp}] total={money(snap['total_amount'])} "
                          f"members={snap['member_count']} "
                          f"paid={snap['paid_count']} "
                          f"outstanding={money(snap['unpaid_total'])}"
                          f"{'' if changed else '  (no change)'}", flush=True)
                prev = sig
            if args.once:
                break
            time.sleep(args.interval)
    except KeyboardInterrupt:
        if not args.json:
            print("\nstopped.", file=sys.stderr)
    return EX_OK


